---
import { experiences } from "../site.config";
import ArrowUpRight from "./ArrowUpRight.astro";

interface Props {
  experience: (typeof experiences)[number];
}

const { experience } = Astro.props;
---

<a class:list={["thoughts-post-card", "experience-post-card", { "has-cover": Boolean(experience.cover) }]} href="/posts/experience-java-internship/">
  {experience.cover && <img class="thoughts-post-card-cover" src={experience.cover} alt={experience.coverAlt ?? `${experience.title} 封面`} loading="lazy" decoding="async" />}
  <div class="thoughts-post-card-content">
    <div class="overview-card-header">
      <span class="card-kicker">技术空间 · 工作经历</span>
      <ArrowUpRight />
    </div>
    <h2>{experience.title}</h2>
    <p>{experience.summary}</p>
    <div class="thoughts-post-meta">
      <time>{experience.period}</time>
      <span>{experience.organization}</span>
    </div>
  </div>
</a>
