---
import { projects } from "../site.config";
import ArrowUpRight from "./ArrowUpRight.astro";

interface Props {
  project: (typeof projects)[number];
}

const { project } = Astro.props;
const projectVisual = project.slug === "eventflow" ? "/project-eventflow.png" : project.slug === "ai-interview-assistant" ? "/project-ai-lake.png" : "/technical-learning-card.png";
---

<article class:list={["project-card", { "has-github": Boolean(project.github) }]}>
  <a class="project-card-main" href={`/projects/${project.slug}/`}>
    <img class="project-card-cover" src={projectVisual} alt={`${project.name} 项目封面`} loading="lazy" decoding="async" />
    <div class="project-card-content">
      <div class="overview-card-header">
        <span class="card-kicker">项目实践 · {project.category}</span>
        <ArrowUpRight />
      </div>
      <h2>{project.name}</h2>
      <p>{project.summary}</p>
      <div class="chip-list compact-chip-list">
        {project.stack.slice(0, 5).map((item) => <span>{item}</span>)}
      </div>
      <div class="project-card-meta">
        <span>{project.role}</span>
        <span>{project.status}</span>
      </div>
    </div>
  </a>
  {project.github ? (
    <a class="project-github-link" href={project.github} target="_blank" rel="noreferrer" aria-label={`打开 ${project.name} GitHub 仓库`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.17c-3.22.7-3.9-1.55-3.9-1.55-.53-1.35-1.3-1.71-1.3-1.71-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.29-.52-1.47.11-3.07 0 0 .98-.31 3.2 1.19a11.1 11.1 0 0 1 5.82 0c2.22-1.5 3.2-1.19 3.2-1.19.63 1.6.23 2.78.11 3.07.75.81 1.2 1.84 1.2 3.11 0 4.45-2.71 5.44-5.29 5.73.42.36.79 1.08.79 2.18v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      <span>GitHub 仓库</span>
    </a>
  ) : (
    <span class="project-github-link is-disabled" aria-label={`${project.name} GitHub 仓库待补充`}>GitHub 仓库待补充</span>
  )}
</article>
