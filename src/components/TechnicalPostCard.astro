---
import type { CollectionEntry } from "astro:content";
import { technicalSectionLabels } from "../lib/technical";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const label = technicalSectionLabels[post.data.section];
---

<a class="thoughts-post-card" href={`/posts/${post.id}/`}>
  <div class="overview-card-header">
    <span class="card-kicker">技术空间 · {label}</span>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </div>
  <h2>{post.data.title}</h2>
  <p>{post.data.description}</p>
  <div class="thoughts-post-meta">
    <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
    {post.data.tags.length > 0 && <span>{post.data.tags.join(" / ")}</span>}
  </div>
</a>
