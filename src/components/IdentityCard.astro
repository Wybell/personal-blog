---
import { getCollection } from "astro:content";
import { getArticleWordCount } from "../lib/article";
import { contactChannels, projects, siteConfig } from "../site.config";

const [blogPosts, lifePosts, thoughtPosts] = await Promise.all([
  getCollection("blog", ({ data }) => !data.draft),
  getCollection("life", ({ data }) => !data.draft),
  getCollection("thoughts", ({ data }) => !data.draft),
]);

const publishedArticles = [...blogPosts, ...lifePosts, ...thoughtPosts];
const articleCount = publishedArticles.length;
const wordCount = publishedArticles.reduce((total, post) => total + getArticleWordCount(post.body), 0);
const latestUpdate = publishedArticles.reduce<Date | undefined>((latest, post) => {
  const candidate = post.data.updatedDate ?? post.data.pubDate;
  return !latest || candidate > latest ? candidate : latest;
}, undefined);
const formatDate = (date?: Date) => {
  if (!date) {
    return "待更新";
  }

  return `${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
};
---

<aside class="identity-card" aria-label="个人资料">
  <div class="identity-topline">
    <div class="avatar-placeholder">
      <img src="/avatar.jpg" alt="Wybell 的头像" />
    </div>
    <div>
      <p class="identity-name">{siteConfig.displayName}</p>
      <p class="identity-role">{siteConfig.role}</p>
    </div>
  </div>
  <div class="identity-location">{siteConfig.location} · 正在记录</div>
  <dl class="profile-stats">
    <div><dt>项目</dt><dd>{String(projects.length).padStart(2, "0")}</dd></div>
    <div><dt>文章</dt><dd>{String(articleCount).padStart(2, "0")}</dd></div>
    <div><dt>总字数</dt><dd>{wordCount.toLocaleString("zh-CN")}</dd></div>
    <div><dt>最近更新</dt><dd>{formatDate(latestUpdate)}</dd></div>
  </dl>
  <div class="profile-links" aria-label="联系方式">
    {siteConfig.github ? (
      <a class="profile-icon-link" href={siteConfig.github} target="_blank" rel="noreferrer" aria-label="打开 GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.17c-3.22.7-3.9-1.55-3.9-1.55-.53-1.35-1.3-1.71-1.3-1.71-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.29-.52-1.47.11-3.07 0 0 .98-.31 3.2 1.19a11.1 11.1 0 0 1 5.82 0c2.22-1.5 3.2-1.19 3.2-1.19.63 1.6.23 2.78.11 3.07.75.81 1.2 1.84 1.2 3.11 0 4.45-2.71 5.44-5.29 5.73.42.36.79 1.08.79 2.18v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </a>
    ) : (
      <span class="profile-icon-link is-disabled" aria-label="GitHub 待补充" title="GitHub 待补充">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.17c-3.22.7-3.9-1.55-3.9-1.55-.53-1.35-1.3-1.71-1.3-1.71-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.29-.52-1.47.11-3.07 0 0 .98-.31 3.2 1.19a11.1 11.1 0 0 1 5.82 0c2.22-1.5 3.2-1.19 3.2-1.19.63 1.6.23 2.78.11 3.07.75.81 1.2 1.84 1.2 3.11 0 4.45-2.71 5.44-5.29 5.73.42.36.79 1.08.79 2.18v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </span>
    )}
    <button class="profile-icon-link is-placeholder" type="button" data-profile-dialog-open data-profile-channel={contactChannels.wechat.label} data-profile-image={contactChannels.wechat.image} aria-label="查看微信联系方式" title="微信">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 4C5.36 4 2 6.45 2 9.47c0 1.78 1.1 3.37 2.86 4.34l-.73 2.34 2.66-1.42c.84.2 1.73.31 2.71.31 4.14 0 7.5-2.45 7.5-5.57S13.64 4 9.5 4Z" /><path d="M14.8 10.5c4 0 7.2 2.15 7.2 5.04 0 1.42-.82 2.7-2.2 3.62l.57 1.84-2.25-1.2c-.75.18-1.51.27-2.32.27-2.16 0-4.1-.7-5.42-1.82" /></svg>
    </button>
    <button class="profile-icon-link" type="button" data-profile-dialog-open data-profile-channel={contactChannels.email.label} data-profile-value={contactChannels.email.value} aria-label="查看 QQ 邮箱" title="QQ邮箱">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
    </button>
    <button class="profile-icon-link is-placeholder profile-icon-qq" type="button" data-profile-dialog-open data-profile-channel={contactChannels.qq.label} data-profile-image={contactChannels.qq.image} aria-label="查看 QQ 联系方式" title="QQ">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <ellipse class="qq-body" cx="12" cy="12.3" rx="6.2" ry="8.4" />
        <ellipse class="qq-belly" cx="12" cy="14.5" rx="3.6" ry="5" />
        <circle class="qq-eye-white" cx="9.8" cy="7.8" r="1.35" />
        <circle class="qq-eye-white" cx="14.2" cy="7.8" r="1.35" />
        <circle class="qq-eye-black" cx="10" cy="8" r="0.48" />
        <circle class="qq-eye-black" cx="14" cy="8" r="0.48" />
        <path class="qq-beak" d="M10.25 9.25h3.5L12 11.35Z" />
        <path class="qq-scarf" d="M6.35 11.4c1.75 1.05 3.65 1.55 5.65 1.55s3.9-.5 5.65-1.55v2.05c-1.75 1.05-3.65 1.55-5.65 1.55s-3.9-.5-5.65-1.55Z" />
        <path class="qq-scarf-tail" d="M15.8 14.25 18 17.9l-2.6-.85-.75-2.45Z" />
        <path class="qq-foot" d="M6.5 19.1c1.35-.25 2.6-.15 3.75.3-.25.95-1.15 1.45-2.3 1.2-1.05-.2-1.6-.7-1.45-1.5Z" />
        <path class="qq-foot" d="M17.5 19.1c-1.35-.25-2.6-.15-3.75.3.25.95 1.15 1.45 2.3 1.2 1.05-.2 1.6-.7 1.45-1.5Z" />
      </svg>
    </button>
    <button class="profile-icon-link is-placeholder" type="button" data-profile-dialog-open data-profile-channel={contactChannels.douyin.label} data-profile-value={contactChannels.douyin.value} aria-label="查看抖音联系方式" title="抖音">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.1a3.2 3.2 0 1 1-2-3V4h5" /></svg>
    </button>
    <button class="profile-icon-link is-placeholder profile-icon-xiaohongshu" type="button" data-profile-dialog-open data-profile-channel={contactChannels.xiaohongshu.label} data-profile-value={contactChannels.xiaohongshu.value} aria-label="查看小红书联系方式" title="小红书">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6.25c-2.18-1.55-4.57-1.7-7.2-.75v11.4c2.63-.95 5.02-.8 7.2.75 2.18-1.55 4.57-1.7 7.2-.75V5.5c-2.63-.95-5.02-.8-7.2.75Z" /><path d="M12 6.25v11.4M8 9.5h1.8M8 12.4h1.8M14.2 9.5H16M14.2 12.4H16" /></svg>
    </button>
  </div>
</aside>

<dialog class="profile-dialog" data-profile-dialog aria-labelledby="profile-dialog-title">
  <div class="profile-dialog-inner">
    <div class="profile-dialog-header">
      <h2 id="profile-dialog-title" data-profile-dialog-title>个人信息</h2>
      <button class="profile-dialog-close" type="button" data-profile-dialog-close aria-label="关闭个人信息" title="关闭">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="profile-dialog-placeholder" data-profile-dialog-placeholder>
      <span data-profile-dialog-placeholder-text>个人信息图片待补充</span>
      <img class="profile-dialog-image" data-profile-dialog-image alt="" hidden />
    </div>
    <p class="profile-dialog-note" data-profile-dialog-note>这里预留二维码或个人介绍图片，后续替换占位区域即可。</p>
  </div>
</dialog>

<script>
  const profileDialog = document.querySelector("[data-profile-dialog]");
  const profileDialogOpenButtons = document.querySelectorAll("[data-profile-dialog-open]");
  const profileDialogClose = document.querySelector("[data-profile-dialog-close]");
  const profileDialogTitle = document.querySelector("[data-profile-dialog-title]");
  const profileDialogPlaceholder = document.querySelector("[data-profile-dialog-placeholder]");
  const profileDialogPlaceholderText = document.querySelector("[data-profile-dialog-placeholder-text]");
  const profileDialogImage = document.querySelector("[data-profile-dialog-image]");
  const profileDialogNote = document.querySelector("[data-profile-dialog-note]");

  if (profileDialog instanceof HTMLDialogElement) {
    profileDialogOpenButtons.forEach((button) => {
      button.addEventListener("click", () => {
          const channel = button.getAttribute("data-profile-channel");
          const value = button.getAttribute("data-profile-value");
          if (channel && profileDialogTitle && profileDialogPlaceholder && profileDialogNote) {
            profileDialogTitle.textContent = `${channel}联系方式`;
            const isEmail = channel === "QQ邮箱" && value;
            const isSocialHandle = (channel === "抖音" || channel === "小红书") && value;
            const imageSource = button.getAttribute("data-profile-image");
            const hasImage = Boolean(imageSource);
            profileDialogPlaceholder.classList.toggle("is-contact", Boolean(isEmail || isSocialHandle));
            profileDialogPlaceholder.classList.toggle("has-image", hasImage);
            if (profileDialogPlaceholderText instanceof HTMLElement) {
              profileDialogPlaceholderText.hidden = hasImage;
              profileDialogPlaceholderText.textContent = isEmail ? value : isSocialHandle ? `${channel}号：${value}` : `${channel}二维码或联系方式待补充`;
          }
          if (profileDialogImage instanceof HTMLImageElement) {
            if (imageSource) {
              profileDialogImage.src = imageSource;
              profileDialogImage.alt = `${channel}二维码`;
              profileDialogImage.hidden = false;
            } else {
              profileDialogImage.removeAttribute("src");
              profileDialogImage.alt = "";
              profileDialogImage.hidden = true;
            }
          }
            profileDialogNote.textContent = isEmail ? "这是我的 QQ 邮箱地址。" : isSocialHandle ? `这是我的${channel}号。` : `这里预留${channel}二维码或联系方式图片，后续补充后即可展示。`;
        }
        profileDialog.showModal();
      });
    });
    profileDialogClose?.addEventListener("click", () => profileDialog.close());
    profileDialog.addEventListener("click", (event) => {
      if (event.target === profileDialog) {
        profileDialog.close();
      }
    });
  }
</script>
