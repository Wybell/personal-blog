---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTechnicalPosts } from "../../lib/technical";
import { experiences, projects, skills } from "../../site.config";

const latestPost = (await getTechnicalPosts("learning"))[0];
const latestPractice = (await getTechnicalPosts("practice"))[0];
const latestExperience = experiences[0];
---

<BaseLayout title="技术空间 | Wybell" description="Wybell 的项目、技术学习、技术栈与工程实践。" currentPath="/technical/">
  <main class="container space-page">
    <header class="page-heading space-heading">
      <p class="eyebrow">TECHNICAL SPACE</p>
      <h1>技术空间</h1>
      <p>把项目、学习和工作里真正做过的事放在一起，记录从想法到交付之间的过程。</p>
    </header>

    <section class="space-card-grid" aria-label="技术空间内容">
      <a class="space-card space-card-featured" href="/technical/projects/">
        <div class="overview-card-header">
          <span class="card-kicker">技术空间 · 项目实践</span>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
        <h2>项目实践</h2>
        <p>从教务系统到 AI 面试助手，再到 EventFlow，三段不同阶段的项目经历。</p>
        <div class="card-line-list">
          {projects.map((project) => <span>{project.name}</span>)}
        </div>
      </a>

      <a class="space-card" href={latestPost ? `/posts/${latestPost.id}/` : "/technical/learning/"}>
        <div class="overview-card-header">
          <span class="card-kicker">技术空间 · 技术学习</span>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
        <h2>{latestPost ? latestPost.data.title : "最近技术记录"}</h2>
        <p>{latestPost ? latestPost.data.description : "把学习过程中的理解、问题和复盘留下来。"}</p>
        <span class="card-placeholder">{latestPost ? latestPost.data.pubDate.toLocaleDateString("zh-CN") : "内容待补充"}</span>
      </a>

      <a class="space-card" href="/technical/stack/">
        <div class="overview-card-header">
          <span class="card-kicker">技术空间 · 技术栈</span>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
        <h2>目前主要使用</h2>
        <p>围绕后端、数据、前端和部署持续积累的技术能力。</p>
        <div class="chip-list">
          {skills.slice(0, 4).map((skill) => <span>{skill}</span>)}
        </div>
      </a>

      <a class="space-card" href={latestPractice ? `/posts/${latestPractice.id}/` : "/technical/practice/"}>
        <div class="overview-card-header">
          <span class="card-kicker">技术空间 · 工程实践</span>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
        <h2>{latestPractice ? latestPractice.data.title : "工程实践记录"}</h2>
        <p>{latestPractice ? latestPractice.data.description : "权限、事务、数据一致性、部署和持续交付等问题，会在这里逐步整理成文章。"}</p>
        <span class="card-placeholder">{latestPractice ? latestPractice.data.pubDate.toLocaleDateString("zh-CN") : "最新实践待补充"}</span>
      </a>

      <a class="space-card" href="/technical/experience/">
        <div class="overview-card-header">
          <span class="card-kicker">技术空间 · 工作经历</span>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
        <h2>{latestExperience.title}</h2>
        <p>{latestExperience.organization} · {latestExperience.period}</p>
        <span class="card-placeholder">{latestExperience.summary}</span>
      </a>
    </section>
  </main>
</BaseLayout>
