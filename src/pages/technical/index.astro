---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowUpRight from "../../components/ArrowUpRight.astro";
import SectionDirectoryCard from "../../components/SectionDirectoryCard.astro";
import SectionIndexHeader from "../../components/SectionIndexHeader.astro";
import { getTechnicalPosts } from "../../lib/technical";
import { experiences, homeSkillGroups, projects, sectionPageContent } from "../../site.config";

const [learningPosts, practicePosts, experiencePosts] = await Promise.all([
  getTechnicalPosts("learning"),
  getTechnicalPosts("practice"),
  getTechnicalPosts("experience"),
]);
const latestPost = learningPosts[0];
const latestPractice = practicePosts[0];
const latestExperience = experiences[0];
const latestExperiencePost = experiencePosts[0];
const technicalDates = [latestPost?.data.pubDate, latestPractice?.data.pubDate, latestExperiencePost?.data.pubDate].filter((date): date is Date => Boolean(date));
const latestTechnicalDate = technicalDates.sort((a, b) => b.valueOf() - a.valueOf())[0];
const formatDate = (date?: Date) => date?.toLocaleDateString("zh-CN") ?? "持续更新";
const pageContent = sectionPageContent.technical;
---

<BaseLayout title="技术空间 | Wybell" description="Wybell 的项目、技术学习、技术栈与工程实践。" currentPath="/technical/">
  <main class="container space-page">
    <SectionIndexHeader
      eyebrow={pageContent.eyebrow}
      title={pageContent.title}
      description={pageContent.description}
      stats={[
        { label: "内容分区", value: "05" },
        { label: "项目数量", value: String(projects.length).padStart(2, "0") },
        { label: "最近更新", value: formatDate(latestTechnicalDate) },
      ]}
    />

    <a class="section-feature-card" href="/technical/projects/">
      <div class="section-feature-card-content">
        <div class="overview-card-header">
          <span class="card-kicker">技术空间 · 项目实践</span>
          <ArrowUpRight />
        </div>
        <h2>从教务系统到 EventFlow</h2>
        <p>三个项目对应三个阶段：先建立后端分层和数据交互的基础，再完成完整产品，最后在 EventFlow 中把状态机、权限、场次配额、报名一致性和线上交付放到同一个业务闭环里验证。</p>
        <span class="section-feature-card-meta">{projects.length.toString().padStart(2, "0")} 个项目 · 34 项后端测试 · 持续复盘</span>
      </div>
      <img class="section-feature-card-cover" src="/project-eventflow.png" alt="EventFlow 项目界面封面" loading="eager" />
    </a>

    <section class="section-directory-grid" aria-label="技术空间内容">
      <SectionDirectoryCard
        href="/technical/learning/"
        kicker="技术空间 · 技术学习"
        title="技术学习"
        description="把学习过程中的理解、问题和复盘留下来。"
        meta={learningPosts.length ? undefined : "暂无公开记录"}
        cover={latestPost?.data.cover}
        coverAlt={latestPost?.data.coverAlt}
        recentPosts={learningPosts.slice(0, 3).map((post) => ({ title: post.data.title, meta: formatDate(post.data.pubDate) }))}
      />
      <a class="section-directory-card technical-overview-stack-card" href="/technical/stack/">
        <div class="section-directory-content">
          <div class="overview-card-header">
            <span class="card-kicker">技术空间 · 技术栈</span>
            <ArrowUpRight />
          </div>
          <h2>当前技术栈</h2>
          <p>按实际接触过的项目方向整理，不代表熟练度排序。</p>
          <div class="stack-overview-grid">
            {homeSkillGroups.map((group) => (
              <div class="stack-overview-group">
                <span class="stack-overview-label">{group.label}</span>
                <div class="stack-overview-items">
                  {group.items.map((skill) => <span>{skill}</span>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </a>
      <SectionDirectoryCard
        href="/technical/practice/"
        kicker="技术空间 · 工程实践"
        title="工程实践"
        description="权限、事务、数据一致性、部署和持续交付等问题，会在这里逐步整理成文章。"
        meta={practicePosts.length ? undefined : "暂无公开记录"}
        cover={latestPractice?.data.cover}
        coverAlt={latestPractice?.data.coverAlt}
        recentPosts={practicePosts.slice(0, 3).map((post) => ({ title: post.data.title, meta: formatDate(post.data.pubDate) }))}
      />
      <SectionDirectoryCard
        href="/technical/experience/"
        kicker="技术空间 · 工作经历"
        title={latestExperience.title}
        description={latestExperience.summary}
        className="experience-directory-card"
        meta={`${latestExperience.organization} · ${latestExperience.period}`}
        cover={latestExperiencePost?.data.cover}
        coverAlt={latestExperiencePost?.data.coverAlt}
        recentPosts={experiencePosts.slice(0, 3).map((post) => ({ title: post.data.title, meta: formatDate(post.data.pubDate) }))}
      />
    </section>
  </main>
</BaseLayout>
