---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import TechnicalPostCard from "../../../../components/TechnicalPostCard.astro";
import { getTechnicalPage, getTechnicalPageCount, getTechnicalPosts, technicalSectionLabels } from "../../../../lib/technical";

export async function getStaticPaths() {
  const paths = [];

  for (const section of Object.keys(technicalSectionLabels)) {
    const allPosts = await getTechnicalPosts(section);
    const totalPages = getTechnicalPageCount(allPosts.length);

    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: { section, page: String(page) },
        props: { posts: getTechnicalPage(allPosts, page), page, totalPages, label: technicalSectionLabels[section as keyof typeof technicalSectionLabels] },
      });
    }
  }

  return paths;
}

const { posts, page, totalPages, label } = Astro.props;
const section = Astro.params.section;
const pagePath = (value: number) => value === 1 ? `/technical/${section}/` : `/technical/${section}/page/${value}/`;
---

<BaseLayout title={`${label} | 技术空间 | Wybell`} description={`Wybell 的${label}文章列表。`} currentPath={`/technical/${section}/`}>
  <main class="container space-page">
    <header class="page-heading space-heading">
      <p class="eyebrow">TECHNICAL SPACE / {label.toUpperCase()}</p>
      <h1>{label}</h1>
      <p>每一张卡片对应一篇记录，按时间从新到旧排列。</p>
    </header>

    <section class="thoughts-post-grid" aria-label={`${label}文章列表`}>
      {posts.map((post) => <TechnicalPostCard post={post} />)}
    </section>

    <nav class="thoughts-pagination" aria-label="技术文章分页">
      {page > 1 ? <a href={pagePath(page - 1)}>上一页</a> : <span class="is-disabled">上一页</span>}
      <span>第 {page} / {totalPages} 页</span>
      {page < totalPages ? <a href={pagePath(page + 1)}>下一页</a> : <span class="is-disabled">下一页</span>}
    </nav>
  </main>
</BaseLayout>
