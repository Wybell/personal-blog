---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SubsectionHeader from "../../components/SubsectionHeader.astro";
import { contactChannels, experiences, sectionNavigation, siteConfig } from "../../site.config";

export function getStaticPaths() {
  return sectionNavigation.about.slice(1).map((item) => ({
    params: { slug: item.href.split("/").filter(Boolean).pop() },
    props: { item },
  }));
}

const { item } = Astro.props;
const slug = Astro.params.slug;
const establishedAt = new Date(`${siteConfig.establishedDate}T00:00:00+08:00`);
const formatSiteUptime = (elapsedMs: number) => {
  const totalMinutes = Math.max(0, Math.floor(elapsedMs / 60000));
  const days = Math.floor(totalMinutes / 1440);
  const hours = Math.floor((totalMinutes % 1440) / 60);
  const minutes = totalMinutes % 60;
  return `${days} 天 ${hours} 小时 ${minutes} 分钟`;
};
const initialSiteAge = formatSiteUptime(Date.now() - establishedAt.getTime());
const establishedDateLabel = siteConfig.establishedDate.replaceAll("-", ".");
const latestUpdateDateLabel = siteConfig.latestUpdateDate.replaceAll("-", ".");
const subsectionDescriptions = {
  experience: "记录从实习到个人项目的实践轨迹，重点保留我实际参与、实现和验证过的内容。",
  status: "记录当前的学习、求职和项目状态，内容会随着实际进展更新。",
  contact: "保留适合公开使用的联系方式，项目交流和技术讨论都可以从这里开始。",
  site: "记录这个个人空间为什么存在，以及它目前是怎样运行的。",
} as const;
const subsectionCounts = {
  experience: "01 段经历",
  status: "持续更新",
  contact: "06 个入口",
  site: "05 项信息",
} as const;
---

<BaseLayout title={`${item.label} | 关于我 | Wybell`} description={`Wybell 的${item.label}内容。`} currentPath={Astro.url.pathname}>
  <main class="container space-page">
    <SubsectionHeader
      eyebrow={`ABOUT / ${item.label.toUpperCase()}`}
      title={item.label}
      description={subsectionDescriptions[slug as keyof typeof subsectionDescriptions]}
      count={subsectionCounts[slug as keyof typeof subsectionCounts]}
      updated={slug === "site" ? latestUpdateDateLabel : "持续更新"}
    />
    {slug === "experience" && (
      <section class="experience-list" aria-label="经历轨迹">
        {experiences.map((experience) => (
          <article class="experience-item">
            <time class="experience-period">{experience.period}</time>
            <div class="experience-content">
              <span class="experience-marker" aria-hidden="true"></span>
              <h2>{experience.title}</h2>
              <p class="experience-organization">{experience.organization}</p>
              <p>{experience.summary}</p>
              <ul>{experience.details.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          </article>
        ))}
      </section>
    )}

    {slug === "status" && (
      <article class="about-copy about-direct-content">
        <p class="eyebrow">CURRENT STATUS</p>
        <h2>目前状态</h2>
        <p>我目前是广州大学软件工程专业 2027 届学生，主要目标是 Java 后端开发岗位，正在准备秋招和后续实习机会。</p>

        <h2>实习经历</h2>
        <p>我已经完成一段 Java 全栈实习，时间为 2026.05—2026.08，在广州平云信息技术有限公司参与企业级组织管理平台开发。</p>
        <ul>
          <li>累计完成 73 个经过测试并上线的工单，其中包括 41 个需求和 32 个缺陷。</li>
          <li>参与审批、待办、组织权限、费用导入、文件下载、分页、批量导入校验、JSON 解析、数据权限、前后端联调、测试验证和上线跟踪。</li>
        </ul>
        <p>这段经历让我获得了真实业务交付经验，不只是完成个人 Demo，也开始熟悉从需求理解、功能实现到测试上线的完整工作流。</p>

        <h2>三个主要项目</h2>
        <ul>
          <li><strong>教务系统：</strong>第一个 Java 后端学习项目，帮助我理解 Spring Boot 分层、MyBatis、MySQL、Redis、Spring Security 和基础 CRUD。它的前端交互、测试、异常处理和工程化程度仍然有限。</li>
          <li><strong>AI 面试助手：</strong>已经完整实现并验证上线，包含简历处理、知识库、AI 出题、模拟面试、SSE 流式输出、答案评分和复盘反馈，形成了较完整的产品闭环。</li>
          <li><strong>EventFlow：</strong>已经完整实现并验证上线，重点处理活动状态机、审核发布、角色权限、场次配额、重复报名、MySQL 条件更新、唯一约束和事务一致性，并完成 Docker、Nginx、GitHub Actions 和手动发布流程。</li>
        </ul>

        <h2>核心技术方向</h2>
        <p>当前主要围绕 Java、Spring Boot、MyBatis/MyBatis-Plus、MySQL、Redis、Spring Security、JWT、事务、权限和数据一致性深入学习，同时接触 Vue、React、TypeScript、SSE、Docker、Nginx、GitHub Actions 和 CI/CD。</p>

        <h2>目前的优势</h2>
        <ul>
          <li>有真实实习和上线交付经历，不只是自己编写 Demo。</li>
          <li>有两个已经部署的完整个人项目，能够接触前后端、数据库、部署和工程交付。</li>
          <li>EventFlow 已经开始涉及状态机、并发一致性和事务边界。</li>
          <li>谨慎区分已经实现、已经验证和仍在学习的内容，不随意夸大自己的经验。</li>
        </ul>

        <dl class="about-fact-list">
          <div><dt>当前身份</dt><dd>广州大学 2027 届软件工程专业学生</dd></div>
          <div><dt>主要目标</dt><dd>Java 后端开发岗位</dd></div>
          <div><dt>实习时间</dt><dd>2026.05—2026.08 · 73 个上线工单</dd></div>
          <div><dt>项目状态</dt><dd>AI 面试助手、EventFlow 已验证上线</dd></div>
          <div><dt>持续维护</dt><dd>个人博客与技术记录</dd></div>
        </dl>
      </article>
    )}

    {slug === "contact" && (
      <article class="about-copy about-direct-content">
        <p class="eyebrow">CONTACT</p>
        <h2>联系方式</h2>
        <p>如果你想了解项目、交流技术，或者只是想打个招呼，可以通过下面的方式联系我。</p>
        <dl class="about-fact-list">
          <div><dt>{contactChannels.github.label}</dt><dd>{contactChannels.github.value ? <a href={contactChannels.github.value} target="_blank" rel="noreferrer">打开主页 ↗</a> : "主页待补充"}</dd></div>
          <div><dt>{contactChannels.wechat.label}</dt><dd><a href={contactChannels.wechat.image} target="_blank" rel="noreferrer">查看二维码 ↗</a></dd></div>
          <div><dt>{contactChannels.email.label}</dt><dd><a href={`mailto:${contactChannels.email.value}`}>{contactChannels.email.value}</a></dd></div>
          <div><dt>{contactChannels.qq.label}</dt><dd><a href={contactChannels.qq.image} target="_blank" rel="noreferrer">查看二维码 ↗</a></dd></div>
          <div><dt>{contactChannels.douyin.label}</dt><dd>{contactChannels.douyin.value}</dd></div>
          <div><dt>{contactChannels.xiaohongshu.label}</dt><dd>{contactChannels.xiaohongshu.value}</dd></div>
        </dl>
      </article>
    )}

    {slug === "site" && (
      <article class="about-copy about-direct-content">
        <p class="eyebrow">ABOUT THIS SITE</p>
        <h2>关于本站</h2>
        <p>这是一个用来记录项目、学习、工作和生活的个人空间。内容会随着实际经历慢慢更新，不追求一次完成。</p>
        <dl class="about-fact-list site-fact-list">
          <div><dt>建立时间</dt><dd>{establishedDateLabel}</dd></div>
          <div><dt>已经运行</dt><dd><span data-site-age data-established={siteConfig.establishedDate}>{initialSiteAge}</span></dd></div>
          <div><dt>更新次数</dt><dd>{siteConfig.updateCount} 次</dd></div>
          <div><dt>生成方式</dt><dd>Astro · 静态站点</dd></div>
        </dl>
        <ul class="about-inline-list">
          <li>Astro</li>
          <li>Markdown</li>
          <li>Static Site Generation</li>
        </ul>
      </article>
    )}
  </main>
</BaseLayout>

{slug === "site" && (
  <script>
    const siteAge = document.querySelector("[data-site-age]");

    if (siteAge) {
      const established = siteAge.getAttribute("data-established");
      const start = established ? new Date(`${established}T00:00:00+08:00`).getTime() : Date.now();

      const updateSiteAge = () => {
        const totalMinutes = Math.max(0, Math.floor((Date.now() - start) / 60000));
        const days = Math.floor(totalMinutes / 1440);
        const hours = Math.floor((totalMinutes % 1440) / 60);
        const minutes = totalMinutes % 60;
        siteAge.textContent = `${days} 天 ${hours} 小时 ${minutes} 分钟`;
      };

      updateSiteAge();
      window.setInterval(updateSiteAge, 60000);
    }
  </script>
)}
