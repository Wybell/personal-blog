---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SubsectionHeader from "../../components/SubsectionHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPostDate = posts[0]?.data.pubDate;
---

<BaseLayout title="技术学习 | Wybell" description="Wybell 的技术学习、项目复盘与问题记录。" currentPath="/technical/learning/">
  <main class="container space-page">
    <SubsectionHeader
      eyebrow="TECHNICAL SPACE / POSTS"
      title="技术文章"
      description="记录项目里遇到的问题、做过的选择，以及那些值得下次少走一步的经验。"
      count={`${posts.length} 篇`}
      updated={latestPostDate?.toLocaleDateString("zh-CN") ?? "暂无"}
    />

    <section class="post-index" aria-label="技术学习文章列表">
      {posts.map((post) => (
        <article class="post-index-item">
          <time class="post-date" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
          <div>
            <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="chip-list compact-chip-list">
              {post.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
